# Bỏ môi trường ảo
.venv/

# Bỏ file cache Python
__pycache__/
*.pyc

# Bỏ file môi trường riêng
.env
backend/data/*.tif

# Cài venv:
python -m venv venv 
hoac py -m venv venv
